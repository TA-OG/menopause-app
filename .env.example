# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://debpdlantsikzocnadrr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_GBP_MONTHLY=price_1TVzZhRnLHfME5fQlE8KNWwk
STRIPE_PRICE_USD_MONTHLY=price_1TVzZmRnLHfME5fQ7F53ibtF
# Optional. Price the 12-month complimentary subscriptions from admin invites
# are created against. The user is never charged for the complimentary period
# (it is entirely a trial); this only determines what they would roll onto if
# they later add a card. Falls back to STRIPE_PRICE_GBP_MONTHLY when unset.
# STRIPE_PRICE_COMPLIMENTARY=price_...

# RESEND (transactional email - resend.com)
# from-address must be on auntymel.app — our only domain, verified in Resend.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@auntymel.app

# BREVO (email marketing + CRM - brevo.com -> Account -> API Keys)
BREVO_API_KEY=xkeysib-...

# PUSH NOTIFICATIONS (generate: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:hello@auntymel.app

# CLOUDFLARE STREAM (video hosting) — see docs/video-hosting.md
# Every video requires signed URLs; the app signs short-lived playback tokens.
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_api_token_with_stream_edit
# Just the code from customer-<code>.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=your_customer_code
# From: npm run stream-setup -- signing-key
CLOUDFLARE_STREAM_SIGNING_KEY_ID=your_signing_key_id
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=your_base64_pem
# From: npm run stream-setup -- webhook https://<your-domain>/api/stream/webhook
CLOUDFLARE_STREAM_WEBHOOK_SECRET=your_webhook_secret

# APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aunty Mel

# CRON SECRET (generate: openssl rand -base64 32)
CRON_SECRET=your_random_secret_here
